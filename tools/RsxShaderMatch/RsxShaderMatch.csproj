<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone research tool, not part of the Godot project. Builds and runs on
       its own via `dotnet run`. Deliberately has no dependency on Soulbrandt.csproj,
       SoulsFormatsNEXT or Godot; it reads loose .fpo/.vpo files already extracted
       under mounted/shader/. See README.md in this directory for what it is for. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rsxshadermatch</AssemblyName>
    <RootNamespace>RsxShaderMatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
